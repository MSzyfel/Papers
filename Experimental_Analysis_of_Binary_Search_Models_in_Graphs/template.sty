% ==================== Liczniki i środowiska ====================
\newcounter{mytheoremcounter}[subsection]
\renewcommand{\themytheoremcounter}{\thesubsection.\arabic{mytheoremcounter}}

\newtheorem{theorem}{Theorem}[subsection]
\newtheorem{lemma}[theorem]{Lemma}
\newtheorem{corollary}[theorem]{Corollary}
\newtheorem{definition}[theorem]{Definition}
\newtheorem{observation}[theorem]{Observation}
\newtheorem{proposition}[theorem]{Proposition}
\newtheorem{remark}[theorem]{Remark}
\newtheorem*{reptheorem}{Theorem}

\AtBeginEnvironment{theorem}{\refstepcounter{mytheoremcounter}}
\AtBeginEnvironment{lemma}{\refstepcounter{mytheoremcounter}}
\AtBeginEnvironment{corollary}{\refstepcounter{mytheoremcounter}}
\AtBeginEnvironment{definition}{\refstepcounter{mytheoremcounter}}

\makeatletter
\@addtoreset{mytheoremcounter}{subsection}
\makeatother

